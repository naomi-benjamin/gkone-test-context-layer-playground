[
    {
        "testCase": "FILTER_MISSING_USER_ID",
        "userId": null,
        "transactionId": "96a42b11-6c35-0dcb-af1a-d5d0f0ccc946",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId contains an invalid value.",
        "notes": "userId is a required URL path parameter and is omitted."
    },
    {
        "testCase": "FILTER_MISSING_TRANSACTION_ID",
        "userId": "5663542d-1093-472d-b5d2-37f1ce149e19",
        "transactionId": null,
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "transactionId contains an invalid value.",
        "notes": ""
    },
    {
        "testCase": "FILTER_MISSING_USER_ID_AND_TRANSACTION_ID",
        "userId": null,
        "transactionId": null,
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId, transactionId contains an invalid value.",
        "notes": ""
    },
    {
        "testCase": "FILTER_USER_ID_AND_TRANSACTION_ID_MISMATCH",
        "userId": "5663542d-1093-472d-b5d2-37f1ce149e19",
        "transactionId": "bf382601-0b2a-c348-2b86-d2c17eefdc8c",
        "expectedStatus": 404,
        "expectEmpty": "false",
        "expectedDetail": "Record does not exist",
        "notes": ""    },
    {
        "testCase": "FILTER_USER_ID_INVALID_GUID",
        "userId": "5663542d-1093-472d-b5d2-37f1ce149e19f",
        "transactionId": "bf382601-0b2a-c348-2b86-d2c17eefdc8c",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId contains an invalid value.",
        "notes": "Invalid userId GUID should fail validation before the transaction lookup is attempted."
    },
    {
        "testCase": "FILTER_TRANSACTION_ID_INVALID_GUID",
        "userId": "053db63f-dbfd-45d1-8677-3bf18b28c093",
        "transactionId": "c675916d-198c-f85c-7b85-7021855a658gs",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "transactionId contains an invalid value.",
        "notes": "Malformed transactionId should be rejected with a validation error."
    },
    {
        "testCase": "FILTER_USER_ID_AND_TRANSACTION_ID_BOTH_INVALID",
        "userId": "5663542d-1093-472d-b5d2-37f1ce149e19f",
        "transactionId": "c675916d-198c-f85c-7b85-7021855a658gs",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId, transactionId contains an invalid value.",
        "notes": "Both IDs are invalid; the API should reject the request at validation time."
    },
    {
        "testCase": "FILTER_VALID_USER_ID_AND_TRANSACTION_ID",
        "userId": "053db63f-dbfd-45d1-8677-3bf18b28c093",
        "transactionId": "6c4d7163-bc6e-4f54-afc4-8e63d7b4479d",
        "expectedStatus": 200,
        "expectEmpty": "false",
        "expectedDetail": "",
        "notes": "Valid pair should return the corresponding transaction result."
    },
    {
        "testCase": "FILTER_VALID_USER_ID_UNKNOWN_TRANSACTION_ID",
        "userId": "fcc75c1d-0f37-477c-a987-922ce38bb0c6",
        "transactionId": "11111111-1111-1111-1111-111111111111",
        "expectedStatus": 404,
        "expectEmpty": "true",
        "expectedDetail": "Record does not exist",
        "notes": "A valid userId with an unknown transactionId should return no matching records rather than a validation failure."
    },
    {
        "testCase": "FILTER_UNKNOWN_USER_ID_VALID_TRANSACTION_ID",
        "userId": "11111111-1111-1111-1111-111111111111",
        "transactionId": "f0595af8-cf27-4977-8001-b1058ccec623",
        "expectedStatus": 404,
        "expectEmpty": "true",
        "expectedDetail": "Record does not exist",
        "notes": "A valid transactionId belonging to a different user should not match and should return an empty result set."
    },
    {
        "testCase": "FILTER_NULL_USER_ID_VALID_TRANSACTION_ID",
        "userId": null,
        "transactionId": "f0595af8-cf27-4977-8001-b1058ccec623",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId contains an invalid value.",
        "notes": "A null userId should be rejected even when the transactionId is valid."
    },
    {
        "testCase": "FILTER_VALID_USER_ID_NULL_TRANSACTION_ID",
        "userId": "db452a82-8ea1-454a-b84c-9664f89b9314",
        "transactionId": null,
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "transactionId contains an invalid value.",
        "notes": "A null transactionId should be rejected even when the userId is valid."
    },
    {
        "testCase": "FILTER_ALPHABETIC_USER_ID",
        "userId": "abcdefghijklmnopqrstuvwxyz",
        "transactionId": "0f26eea7-1065-4469-8a32-4cff27302434",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId contains an invalid value.",
        "notes": "Alphabetic userId should fail GUID validation."
    },
    {
        "testCase": "FILTER_ALPHABETIC_TRANSACTION_ID",
        "userId": "db452a82-8ea1-454a-b84c-9664f89b9314",
        "transactionId": "abcdefghijklmnopqrstuvwxyz",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "transactionId contains an invalid value.",
        "notes": "Alphabetic transactionId should fail GUID validation."
    },
    {
        "testCase": "FILTER_ALPHABETIC_USER_ID_AND_TRANSACTION_ID",
        "userId": "abcdefghijklmnopqrstuvwxyz",
        "transactionId": "abcdefghijklmnopqrstuvwxyz",
        "expectedStatus": 400,
        "expectEmpty": "false",
        "expectedDetail": "userId, transactionId contains an invalid value.",
        "notes": "Both alphabetic IDs should be rejected as invalid GUIDs."
    }
]
